---
import BaseLayout from './BaseLayout.astro';
import SEO from '@lad-sapienza/scms-core/components/SEO/SEO.astro';
import { siteMetadata } from '../user.config.mjs';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    date?: string | Date;
    author?: string;
    tags?: string[];
  };
}

const { frontmatter } = Astro.props;

---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <Fragment slot="head">
    <SEO 
      title={frontmatter.title} 
      description={frontmatter.description}
      isArticle={true}
      datePublished={frontmatter.date}
      author={frontmatter.author}
      tags={frontmatter.tags}
      siteMetadata={siteMetadata}
    />
  </Fragment>
  <article class="scms-prose">
    <header class="mb-5">
      <h1>{frontmatter.title}</h1>
    </header>
    
    <div class="markdown-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* .markdown-content's own typography lives in global.css — shared with
     docs/[...slug].astro and blog/[...slug].astro, so every content type
     gets the same prose styling from one place. */
  .scms-prose {
    max-width: none;
    font-size: 1.125rem;
    line-height: 1.7;
  }
</style>
