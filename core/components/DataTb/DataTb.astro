---
/**
 * DataTb Astro Wrapper
 *
 * Astro component that wraps the React DataTb component
 * This file exists for documentation and re-export purposes.
 * In MDX files, import the React component directly with a hydration directive.
 *
 * Example usage in MDX:
 * ```jsx
 * import { DataTb } from '@core/components/DataTb';
 *
 * <DataTb csv="/data.csv" searchable pagination client:idle />
 * ```
 *
 * CsvSource / JsonSource / DirectusSource / ApiSource are also exported, but as
 * headless data-loaders (they render nothing; they call onDataLoad/onLoadingChange/
 * onError) for building a fully custom table UI — they are not children of
 * <DataTb>, which has no children/composition API. See the "Headless Source
 * Components" section of usr/content/docs/components/datatb.mdx.
 */

// Re-export for convenience
export { DataTb, CsvSource, JsonSource, DirectusSource, ApiSource } from './index';
export type * from './types';
---

<slot />
